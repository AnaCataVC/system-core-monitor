<UserControl x:Class="SystemCoreMonitor.Views.StorageView"
             xmlns:conv="clr-namespace:SystemCoreMonitor.UI.Converters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="950">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:ThresholdToBrushConverter x:Key="ThresholdBrushConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
        <StackPanel>

            <!-- 1. Storage Header Hero Card -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Icon + Title + Subtitle + Timestamp -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="{DynamicResource AccentDiskAlpha}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDisk}" Fill="{DynamicResource AccentDisk}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderTitleText}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastUpdatedDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastUpdatedDisplay}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LastUpdatedDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding HeaderDescText}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Refresh & Storage Sense Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}" Padding="12,7" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                    <Setter Property="Background" Value="{DynamicResource AccentDiskAlpha}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentDisk}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSync}" Fill="{DynamicResource AccentDisk}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding RefreshBtnText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding OpenStorageToolCommand}" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLaunch}" Fill="{DynamicResource TextSecondary}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OpenPcManagerBtnText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. KPI Summary Strip -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <!-- Total Capacity -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding KpiCapacityLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding TotalCapacityDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding DrivesCountDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Used Space -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding KpiUsedLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding OverallPercentDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding OverallPercentUsed, Converter={StaticResource ThresholdBrushConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalUsedDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,6"/>
                        <ProgressBar Style="{StaticResource PastelProgressBarStyle}" Value="{Binding OverallPercentUsed}" Foreground="{Binding OverallPercentUsed, Converter={StaticResource ThresholdBrushConverter}}" Height="5"/>
                    </StackPanel>
                </Border>

                <!-- Free Space -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{Binding KpiFreeLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding TotalFreeDisplay}" FontSize="20" FontWeight="Bold" Foreground="{Binding OverallPercentUsed, Converter={StaticResource ThresholdBrushConverter}}" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding DriveFreeLabel}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Reclaimable Caches / Bloat -->
                <Border Style="{StaticResource BentoCardStyle}" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding KpiReclaimableLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding ReclaimableSizeDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentDisk}" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding BloatSummarySubtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. Quick Maintenance Action Bar -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="12,9" Margin="0,0,0,14">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CleanTempCommand}" Margin="0,2,8,2" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyCleaning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CleanTempBtnText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding EmptyRecycleBinCommand}" Margin="0,2,8,2" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusyCleaning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding EmptyBinBtnText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ScanBloatCommand}" Margin="0,2,8,2" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningBloat}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ScanButtonText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ScanFolderCommand}" Margin="0,2,0,2" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningFolder}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AnalyzerScanProfileBtnText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- 4. Drives Section -->
            <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding DrivesTitleText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DrivesCountDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BentoCardStyle}" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Top Row: Drive Info (Left) + Percentage & Quick Actions (Right) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDisk}" Fill="{Binding PercentUsed, Converter={StaticResource ThresholdBrushConverter}}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VolumeLabel, StringFormat='{} ({0})'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>

                                        <!-- Filesystem Pill (NTFS, exFAT, etc.) -->
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasDriveFormat, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{Binding DriveFormat}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PercentUsed, StringFormat='{}{0:F0}%'}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{Binding PercentUsed, Converter={StaticResource ThresholdBrushConverter}}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <Button Style="{StaticResource PillActionButtonStyle}"
                                                Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="9,4" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DataContext.DriveOpenBtnText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.ScanFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding RootPath}"
                                                Padding="9,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsScanningFolder, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔍" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DataContext.DriveScanBtnText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Usage Bar (color-coded by threshold) -->
                                <ProgressBar Style="{StaticResource PastelProgressBarStyle}" Value="{Binding PercentUsed}"
                                             Foreground="{Binding PercentUsed, Converter={StaticResource ThresholdBrushConverter}}"
                                             Height="8" Margin="0,0,0,10"/>

                                <!-- Bottom Row: Used / Free / Total -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DataContext.DriveUsedLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding UsedGB, StringFormat='{}{0:F1} GB'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.DriveFreeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding FreeGB, StringFormat='{}{0:F1} GB'}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding PercentUsed, Converter={StaticResource ThresholdBrushConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DataContext.DriveTotalLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding TotalGB, StringFormat='{}{0:F1} GB'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. On-Demand Folder Space Analyzer -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="14,12" Margin="0,4,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AnalyzerTitleText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding AnalyzerSubtitleText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillActionButtonStyle}"
                                    Command="{Binding CancelFolderScanCommand}"
                                    Background="#22EF4444" Foreground="#EF4444"
                                    Padding="10,5"
                                    Visibility="{Binding IsScanningFolder, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding AnalyzerCancelBtnText}" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Idle Hint -->
                    <TextBlock Text="{Binding AnalyzerIdleHintText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Visibility="{Binding ShowFolderScanIdleHint, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Scan Status & Live Progress -->
                    <StackPanel Visibility="{Binding HasFolderScanStatus, Converter={StaticResource BoolToVisConverter}}" Margin="0,2,0,6">
                        <TextBlock Text="{Binding FolderScanStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentDisk}" TextWrapping="Wrap"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,4"
                                     Background="{DynamicResource BgControl}" Foreground="{DynamicResource AccentDisk}" BorderThickness="0"
                                     Visibility="{Binding IsScanningFolder, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="{Binding FolderScanProgressText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsScanningFolder, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <!-- Top Folder Results -->
                    <ItemsControl ItemsSource="{Binding FolderScanEntries}"
                                  Visibility="{Binding HasFolderScanResults, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgControl}" CornerRadius="7" Padding="10,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                                    <TextBlock Text="*" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource StatusWarn}" Margin="3,0,0,0"
                                                               Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentDisk}" Margin="8,0,0,0"/>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource PastelProgressBarStyle}" Value="{Binding PercentOfLargest}" Foreground="{DynamicResource AccentDisk}" Height="5"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource PillActionButtonStyle}"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding FullPath}"
                                                ToolTip="{Binding DataContext.AnalyzerOpenFolderTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="📂" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Skipped Entries Note -->
                    <TextBlock Text="{Binding FolderScanSkippedText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasFolderScanSkipped, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
            </Border>

            <!-- 6. Bloat & Cache Cleaners Section -->
            <Grid Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BloatTitleText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BloatCountDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentDisk}"/>
                    </Border>
                </StackPanel>

                <!-- Filter Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetBloatFilterCommand}" CommandParameter="All" Padding="10,4" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgControlActive}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentDisk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding BloatFilterAllText}" FontSize="11.5" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding SetBloatFilterCommand}" CommandParameter="Cleanable" Padding="10,4" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterCleanable}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgControlActive}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentDisk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding BloatFilterCleanableText}" FontSize="11.5" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding SetBloatFilterCommand}" CommandParameter="System" Padding="10,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterSystem}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgControlActive}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentDisk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding BloatFilterSystemText}" FontSize="11.5" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Empty Bloat State -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="16,14" Margin="0,0,0,8"
                    Visibility="{Binding HasNoBloatFindings, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding EmptyBloatText}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </Border>

            <!-- Bloat Findings List -->
            <ItemsControl ItemsSource="{Binding BloatFindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BentoCardStyle}" Padding="0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Severity Accent Strip -->
                                <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentDisk}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Crit">
                                                    <Setter Property="Background" Value="{DynamicResource StatusCrit}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource StatusWarn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Content Column (Never Clips Behind Buttons) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,10,14,10">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentDisk}"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ActionHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,3,0,0"
                                               Visibility="{Binding HasPath, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>

                                <!-- Right Actions Column -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,14,10">
                                    <Button Style="{StaticResource PillActionButtonStyle}"
                                            Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"
                                            ToolTip="{Binding DataContext.BloatOpenPathTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="8,5" Margin="0,0,6,0"
                                            Visibility="{Binding HasPath, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="📂" FontSize="12"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.ExecuteBloatActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource AccentDisk}" Foreground="White" Padding="11,5"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsBusyCleaning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding ActionLabel, FallbackValue='Clean'}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.CompactVhdxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5" Margin="6,0,0,0"
                                            Visibility="{Binding IsDockerDisk, Converter={StaticResource BoolToVisConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PillActionButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsBusyCleaning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding DataContext.CompactVhdxShortBtnText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>

                                    <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="9,4" VerticalAlignment="Center"
                                            Visibility="{Binding IsInformational, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding DataContext.BloatInfoBadgeText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>