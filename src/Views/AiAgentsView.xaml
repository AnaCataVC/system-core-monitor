<UserControl x:Class="SystemCoreMonitor.Views.AiAgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
        <StackPanel>
            <!-- Summary Banner -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="16,12" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sesiones de Asistentes IA &amp; Servidores MCP" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Monitoreo en tiempo real de Claude Code, Gemini CLI y herramientas MCP" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Sessions.Count, StringFormat='{}Sesiones: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentCpu}"/>
                        </Border>
                        <Border Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{Binding Metric.TotalAggregatedRamDisplay, StringFormat='{}RAM Total: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentRam}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Orphan Processes Alert Card: one expandable row per ended session -->
            <Border Style="{StaticResource BentoCardStyle}" Background="#2D1515" BorderBrush="#EF4444" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrphanCount, StringFormat='{}Procesos huérfanos detectados: {0}'}" FontSize="13.5" FontWeight="Bold" Foreground="#FCA5A5"/>
                                <TextBlock Text="Procesos que dejó una sesión de agente IA ya terminada. Revisa la evidencia antes de cerrarlos." FontSize="11.5" Foreground="#F87171" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PillActionButtonStyle}" Command="{Binding KillAllOrphansCommand}" Background="#EF4444" Foreground="White" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="Cerrar Todos" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OrphanGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3B1818" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="Bold" FontSize="12.5" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Style="{StaticResource PillActionButtonStyle}" Padding="8,4" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ToggleOrphanGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="▼ Ver procesos"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="▲ Ocultar"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource PillActionButtonStyle}" Background="#DC2626" Foreground="White" Padding="8,4" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.KillOrphanGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Cerrar grupo" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Processes}" Margin="0,6,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2A1111" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <WrapPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="12.5" Foreground="White" Margin="0,0,8,2" VerticalAlignment="Center"/>
                                                                    <Border Background="#450A0A" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding SemanticRole}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                                                                    </Border>
                                                                    <Border Background="#450A0A" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Pid, StringFormat='{}PID: {0}'}" FontSize="11" Foreground="#FECACA"/>
                                                                    </Border>
                                                                    <Border Background="#450A0A" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding MemoryDisplay, StringFormat='{}RAM: {0}'}" FontSize="11" Foreground="{DynamicResource AccentRam}"/>
                                                                    </Border>
                                                                    <Border Background="#450A0A" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding AgeDisplay, StringFormat='{}Edad: {0}'}" FontSize="11" Foreground="#E2E8F0"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding OrphanReason}" FontSize="11" Foreground="#F87171" VerticalAlignment="Center" Margin="4,0,0,2"/>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding CommandLine}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#94A3B8"
                                                                           TextTrimming="CharacterEllipsis" Margin="2,4,8,0"
                                                                           ToolTip="{Binding TooltipText}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource PillActionButtonStyle}"
                                                                    Command="{Binding DataContext.KillOrphanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#DC2626" Foreground="White" Padding="10,5" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <TextBlock Text="Cerrar" FontSize="11.5" FontWeight="SemiBold"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unified AI Agent Storage & Maintenance Bento Card -->
            <Border Style="{StaticResource BentoCardStyle}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Master Header with One-Click Scan & Cancel -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="🗄️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Almacenamiento y Limpieza de Agentes IA" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Historiales de conversación, ramas temporales (worktrees) y cachés de Claude, Gemini y Antigravity" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding ScanAllStorageCommand}" Margin="0,0,8,0" Padding="12,6" Background="{DynamicResource AccentCpu}" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Escanear Todo" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillActionButtonStyle}" Command="{Binding CancelLeftoverScanCommand}" Margin="0,0,8,0" Padding="10,6"
                                    Visibility="{Binding IsScanningLeftovers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Cancelar" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sub-section 1: Historiales de Conversaciones (Transcripts) -->
                    <Border Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Historiales de Conversaciones (Transcripts)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButtonStyle}" Command="{Binding CleanStaleTranscriptsCommand}" Background="#D97706" Foreground="White" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CleanButtonText, FallbackValue='Limpiar (>7d)'}" FontSize="11.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <!-- Transcript Telemetry Summary -->
                            <TextBlock Text="{Binding TranscriptSummaryDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>

                            <!-- Discovered Stores Grid / Chips -->
                            <ItemsControl ItemsSource="{Binding TranscriptReport.Stores}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgControlHover}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StoreName}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                                                <Border Background="{DynamicResource BgControlActive}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding TotalSizeDisplay, StringFormat='{}Total: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                                <Border Background="#2D1515" CornerRadius="4" Padding="5,2">
                                                    <TextBlock Text="{Binding StaleSizeDisplay, StringFormat='{}Liberable: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sub-section 2: Restos Temporales y Worktrees -->
                    <Border Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🌿" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ramas de Agentes (Worktrees) y Archivos Temporales" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButtonStyle}" Command="{Binding CleanLeftoversCommand}" Background="#D97706" Foreground="White" Padding="10,5"
                                        Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpiar seleccionables" FontSize="11.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <!-- Leftovers Telemetry Summary -->
                            <TextBlock Text="{Binding LeftoverSummaryDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                            <!-- Safety Warning Banner when items are protected -->
                            <Border Background="#2A1B0E" BorderBrush="#B45309" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                    Visibility="{Binding HasProtectedLeftovers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Los elementos marcados como 'Protegido' contienen cambios de código sin guardar o sesiones recientes para evitar pérdida de datos." FontSize="11.5" Foreground="#FBBF24" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Leftover Items Table -->
                            <ItemsControl ItemsSource="{Binding LeftoverItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgControlHover}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource BgControlActive}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11.5" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="{DynamicResource AccentRam}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                    <Setter Property="Background" Value="#451A03"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓ Limpiable"/>
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                        <Setter Property="Text" Value="🔒 Protegido"/>
                                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Active Sessions List -->
            <TextBlock Text="Sesiones Activas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BentoCardStyle}" Margin="0,0,0,12" Padding="14,12">
                            <StackPanel>
                                <!-- Session Header Row -->
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButtonStyle}" 
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" Padding="10,5">
                                        <TextBlock Text="Terminar Sesión" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{Binding StatusBadgeColor, FallbackValue='#10B981'}" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AgentName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ParentPid, StringFormat='{}(PID {0})'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        
                                        <!-- Model Badge (e.g. claude-opus-5, gemini) -->
                                        <Border Background="{DynamicResource BgControlHover}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModelName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ModelName}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ModelName, StringFormat='{}🧬 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentGpu}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Session Context / Repository Badge -->
                                <Border Background="{DynamicResource BgControlActive}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SessionContext}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionContext}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding SessionContext}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>

                                <!-- Session Telemetry Chips and Subprocess Toggle -->
                                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButtonStyle}"
                                            Command="{Binding DataContext.ToggleSessionExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasChildProcesses, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExpandToggleText}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Button>

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,3" Margin="0,0,6,2">
                                            <TextBlock Text="{Binding TotalMemoryDisplay, StringFormat='{}RAM: {0}'}" FontSize="12" Foreground="{DynamicResource AccentRam}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,3" Margin="0,0,6,2">
                                            <TextBlock Text="{Binding TotalCpuDisplay, StringFormat='{}CPU: {0}'}" FontSize="12" Foreground="{DynamicResource AccentCpu}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BgControl}" CornerRadius="4" Padding="6,3" Margin="0,0,6,2">
                                            <TextBlock Text="{Binding McpServersCount, StringFormat='{}MCP: {0}'}" FontSize="12" Foreground="{DynamicResource AccentGpu}"/>
                                        </Border>
                                    </WrapPanel>
                                </DockPanel>

                                <!-- Subprocesses / MCP Servers Items (Collapsible) -->
                                <ItemsControl ItemsSource="{Binding ChildProcesses}" Margin="12,4,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgControlHover}" CornerRadius="4" Padding="8,4" Margin="0,2">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <TextBlock Text="{Binding MemoryDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding CpuDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="└ " Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding SemanticRole}" FontSize="11" Foreground="{DynamicResource AccentCpu}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>