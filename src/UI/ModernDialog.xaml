<Window x:Class="SystemCoreMonitor.UI.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MaxHeight="560"
        ShowInTaskbar="False"
        Topmost="False">

    <Border Margin="14"
            Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderCard}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgCard}"
                    CornerRadius="12,12,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Accent Icon Badge -->
                    <Border Name="IconBadge" Grid.Column="0" Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Name="IconPath" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Name="TxtTitle" Grid.Column="1"
                               FontSize="14.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Click="Cancel_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="28" Height="28"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="closeBg" Background="Transparent" CornerRadius="6">
                                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMuted}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="{DynamicResource BgControlHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Message Body -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="340"
                          Padding="20,16">
                <TextBlock Name="TxtMessage"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Action Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="BtnCancel"
                            Style="{StaticResource PillActionButtonStyle}"
                            IsCancel="True"
                            Click="Cancel_Click"
                            MinWidth="88"
                            Padding="16,7"
                            Margin="0,0,8,0"/>

                    <Button Name="BtnConfirm"
                            Style="{StaticResource PillActionButtonStyle}"
                            IsDefault="True"
                            Click="Confirm_Click"
                            MinWidth="96"
                            Padding="18,7"
                            FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
